<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<!-- SMTP Settings-->
		<add key="strNewSMTPHost_Host1" value="" />
		<add key="intNewSMTPPort_Host1" value="587" />
		<add key="blnIsSSLEnabled_Host1" value="true" />
		<add key="strNewSMTPFromEmail_Host1" value="" />
		<add key="strToEmail_Host1" value="" />
		
		<add key="strNewSMTPHost_Host2" value="" />
		<add key="intNewSMTPPort_Host2" value="25" />
		<add key="blnIsSSLEnabled_Host2" value="true"/>
		<add key="strNewSMTPFromEmail_Host2" value="" />
		<add key="strToEmail_Host2" value="" />
		
		<add key="strNewSMTPAuthPwd_Host1" value="" />
		<add key="strNewSMTPAuthPwd_Host2" value="" />

		<!-- Time values and Formate -->
		<add key="RequiredProductiveFormat" value="Hours" />
		<add key="AllowedBreakFormat" value="Hours" />
		<add key="FullDayRequiredProductive" value="8" />
		<add key="FullDayAllowedBreak" value="1" />
		<add key="HalfDayRequiredProductive" value="4" />
		<add key="HalfDayAllowedBreak" value="0.5" />
		<add key="OfficialStartTime" value="10:30" />
		<add key="OfficialEndTime" value="19:30" />
	</appSettings>
</configuration>
